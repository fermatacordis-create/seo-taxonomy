msgstr "Corbeille"

msgid "Mail folders"
msgstr "Dossiers de messagerie"

msgid "Back to messages"
msgstr "Retour aux messages"

msgid "This special folder is not available on the mail server."
msgstr "Ce dossier spécial n’est pas disponible sur le serveur."

msgid "Unable to access the mailbox. Check IMAP settings and permissions or test on a dedicated mailbox."
msgstr "Impossible d’accéder à la boîte. Vérifiez la connexion IMAP et les autorisations ou utilisez un compte de test."

msgid "Search messages"
msgstr "Rechercher des messages"

