msgid "Mail folders"
msgstr "E-mailmappen"

msgid "Back to messages"
msgstr "Terug naar berichten"

msgid "This special folder is not available on the mail server."
msgstr "Deze speciale map is niet beschikbaar op de mailserver."

msgid "Unable to access the mailbox. Check IMAP settings and permissions or test on a dedicated mailbox."
msgstr "Kan de mailbox niet openen. Controleer IMAP-instellingen en rechten of test met een aparte mailbox."

msgid "Search messages"
msgstr "Berichten zoeken"

msgid "Search"
msgstr "Zoeken"

